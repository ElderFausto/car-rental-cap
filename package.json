{
  "name": "car-rental-cap",
  "version": "1.0.0",
  "dependencies": {
    "@sap/cds": "^10",
    "@sap/xssec": "^4",
    "@cap-js/sqlite": "^3"
  },
  "devDependencies": {
    "@sap/cds-dk": "^10",
    "cds-plugin-ui5": "^0.17.0"
  },
  "scripts": {
    "start": "cds-serve",
    "watch-cars": "cds watch --open car.rental.cars/index.html?sap-ui-xx-viewCache=false --livereload false"
  },
  "engines": {
    "node": ">=18"
  },
  "private": true,
  "workspaces": [
    "app/*"
  ],
  "sapux": [
    "app/cars"
  ],
  "cds": {
    "requires": {
      "db": {
        "kind": "sqlite",
        "credentials": {
          "url": "db.sqlite"
        }
      },
      "auth": {
        "kind": "dummy"
      }
    }
  }
}
